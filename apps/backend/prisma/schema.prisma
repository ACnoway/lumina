// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== 用户表 ====================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?  // bcrypt hashed, nullable for email-code login
  nickname  String?
  avatar    String?
  role      UserRole @default(USER)
  status    UserStatus @default(ACTIVE)
  
  // 关联钱包
  wallet    Wallet?
  
  // 聊天会话
  chatSessions ChatSession[]
  
  // 生图记录
  imageGenerations ImageGeneration[]

  // 支付订单
  paymentOrders PaymentOrder[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

// ==================== 钱包/账本 ====================
model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  balance Decimal @default(0) @db.Decimal(18, 6) // 余额（光子）
  
  transactions WalletTransaction[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("wallets")
}

model WalletTransaction {
  id       String @id @default(cuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  
  type     TransactionType
  amount   Decimal @db.Decimal(18, 6)
  balance  Decimal @db.Decimal(18, 6) // 交易后余额（光子）
  reason   String // 交易原因描述
  metadata Json? // 额外元数据
  
  // 幂等键，防止重复交易
  idempotencyKey String? @unique
  
  createdAt DateTime @default(now())
  
  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

enum TransactionType {
  RECHARGE      // 充值
  CONSUME       // 消费
  REFUND        // 退款
  ADMIN_ADJUST  // 管理员调整
}

// ==================== 聊天会话 ====================
model ChatSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title  String @default("新对话")
  
  messages ChatMessage[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  role      MessageRole
  content   String      @db.Text
  
  // 计费信息
  tokens    Int?        // 消耗的 token 数
  cost      Decimal?    @db.Decimal(18, 6) // 本条消息的成本（光子）
  
  createdAt DateTime @default(now())
  
  @@index([sessionId])
  @@index([createdAt])
  @@map("chat_messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ==================== 生图记录 ====================
model ImageGeneration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  prompt       String @db.Text
  originalPrompt String? @db.Text  // 用户原始输入（优化前）
  negativePrompt String? @db.Text
  model        String // 平台模型名
  provider     String // 实际上游供应商名
  
  status       ImageStatus @default(PENDING)
  
  // 生成参数
  width        Int?
  height       Int?
  steps        Int?
  cfgScale     Float?
  seed         Int?
  parameters   Json? // 其他参数
  
  // 结果
  imageUrl     String?
  imageKey     String? // MinIO 存储 key
  images       ImageGenerationImage[]
  
  // 计费
  cost         Decimal? @db.Decimal(18, 6) // 光子
  
  // 错误信息
  errorMessage String? @db.Text
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("image_generations")
}

// ==================== 支付 ====================
enum PaymentChannelType {
  EPAY
  ALIPAY
  WECHAT
}

enum PaymentMethod {
  ALIPAY
  WECHAT
}

enum PaymentScene {
  WEB
  H5
  QR
  JSAPI
  APP
}

enum PaymentOrderStatus {
  CREATED
  PENDING
  SUCCEEDED
  FAILED
  CLOSED
  EXPIRED
  REFUNDED
}

model PaymentChannel {
  id              String             @id @default(cuid())
  name            String
  type            PaymentChannelType
  isActive        Boolean            @default(true)
  publicConfig    Json?
  configEncrypted String             @db.Text
  configVersion   Int                @default(1)

  orders  PaymentOrder[]
  events  PaymentCallbackEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("payment_channels")
}

model PaymentOrder {
  id                String             @id @default(cuid())
  orderNo           String             @unique
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  channelId         String
  channel           PaymentChannel     @relation(fields: [channelId], references: [id])
  channelType       PaymentChannelType
  paymentMethod     PaymentMethod
  scene             PaymentScene
  amount            Decimal            @db.Decimal(10, 2)
  currency          String             @default("CNY")
  photonAmount      Decimal            @db.Decimal(18, 6)
  photonPerCny      Decimal            @db.Decimal(18, 6)
  subject           String
  status            PaymentOrderStatus @default(CREATED)
  providerTradeNo   String?
  paidAmount        Decimal?           @db.Decimal(10, 2)
  paidAt            DateTime?
  expireAt          DateTime?
  clientIp          String?
  idempotencyKey    String?
  metadata          Json?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([channelId])
  @@index([status])
  @@index([providerTradeNo])
  @@index([createdAt])
  @@map("payment_orders")
}

model PaymentCallbackEvent {
  id             String   @id @default(cuid())
  channelId      String
  channel        PaymentChannel @relation(fields: [channelId], references: [id])
  orderNo        String?
  eventKey       String
  signatureValid Boolean
  processed      Boolean  @default(false)
  payloadHash    String
  errorMessage   String?
  createdAt      DateTime @default(now())
  processedAt    DateTime?

  @@unique([channelId, eventKey])
  @@index([orderNo])
  @@index([createdAt])
  @@map("payment_callback_events")
}

model ImageGenerationImage {
  id           String         @id @default(cuid())
  generationId String
  generation   ImageGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  sequence     Int
  status       ImageStatus    @default(PENDING)
  retryCount   Int            @default(0)
  width        Int?
  height       Int?
  imageUrl     String?
  imageKey     String?
  cost         Decimal?       @db.Decimal(18, 6) // 光子
  errorMessage String?        @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([generationId, sequence])
  @@index([generationId])
  @@index([status])
  @@map("image_generation_images")
}

enum ImageStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

// ==================== 上游供应商配置 ====================
model Provider {
  id               String   @id @default(cuid())
  name             String   @unique // openai, anthropic, stability 等

  apiFormat        ApiFormat                         // 请求格式
  supportsStreaming Boolean  @default(true)          // 是否支持流式
  config           Json                              // apiKey, baseUrl, timeout, rateLimit 等
  isActive         Boolean  @default(true)

  upstreamModels  UpstreamModel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("providers")
}

enum ApiFormat {
  openai_chat           // OpenAI Chat Completions
  openai_compatible     // OpenAI 兼容格式（代理商等）
  anthropic_messages    // Anthropic Messages API
  openai_image          // OpenAI Images API
  stability_image       // Stability AI 生图
}

// ==================== 平台模型 ====================
model PlatformModel {
  id          String   @id @default(cuid())
  name        String   @unique              // 平台模型名，如 gpt-4o
  displayName String                          // 展示名
  type        ModelType                       // CHAT 或 IMAGE
  isActive    Boolean  @default(true)
  pricing     Json                            // 计费标准 { input: number, output: number } 或 { perImage: number }
  maxTokens   Int?                            // 平台限制的最大 token

  upstreamModels UpstreamModel[]
  promptOptimizerConfigs SystemConfig[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
  @@map("platform_models")
}

// ==================== 系统配置 ====================
model SystemConfig {
  id                    Int           @id @default(1)
  promptOptimizerModelId String?
  promptOptimizerModel  PlatformModel? @relation(fields: [promptOptimizerModelId], references: [id], onDelete: SetNull)
  photonPerCny          Decimal       @default(10) @db.Decimal(18, 6)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}

enum ModelType {
  CHAT
  IMAGE
}

// ==================== 上游模型映射 ====================
model UpstreamModel {
  id              String   @id @default(cuid())
  platformModelId String
  platformModel   PlatformModel @relation(fields: [platformModelId], references: [id], onDelete: Cascade)

  providerId      String
  provider        Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)

  upstreamModelId String                        // 上游实际模型名，如 gpt-4o-2024-08-06
  priority        Int      @default(1)          // 数字越小越优先
  weight          Int      @default(1)          // 同优先级权重（加权随机）
  isActive        Boolean  @default(true)

  upstreamPricing Json?                         // 上游成本 { input, output } 或 { perImage }
  maxTokens       Int?                          // 上游限制（可选覆盖平台值）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformModelId])
  @@index([providerId])
  @@index([priority])
  @@map("upstream_models")
}

// ==================== 审计日志 ====================
model AuditLog {
  id String @id @default(cuid())
  
  userId    String?
  action    String // 操作类型
  resource  String // 资源类型
  details   Json? // 操作详情
  ipAddress String?
  userAgent String?
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}
