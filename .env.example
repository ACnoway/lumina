# ======================
# Docker Compose 变量（docker-compose.yml 中 ${VAR} 替换用）
# ======================
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina_password
POSTGRES_DB=lumina

# Redis 密码（Docker 内网不设密码，留空）
REDIS_PASSWORD=

# MinIO 对象存储
MINIO_ACCESS_KEY=lumina_minio
MINIO_SECRET_KEY=lumina_minio_secret
MINIO_BUCKET=lumina-images

# ======================
# 应用端口
# ======================
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ======================
# JWT 配置
# ======================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ======================
# CORS 配置
# ======================
CORS_ORIGIN=http://localhost:3000

# ======================
# 邮件服务配置 (SMTP)
# ======================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Lumina <noreply@example.com>"

# ======================
# 新用户初始余额（单位：元）
# ======================
INITIAL_BALANCE=10.00

# ======================
# 本地开发连接配置（Docker 部署时由 docker-compose.yml 覆盖为内网地址）
# ======================
DATABASE_URL="postgresql://lumina:lumina_password@localhost:5432/lumina?schema=public"
REDIS_URL="redis://localhost:6379"
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false

# ======================
# 其他
# ======================
NODE_ENV=development
LOG_LEVEL=debug

# 管理员初始配置
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
