# ======================
# Docker Compose 变量（docker-compose.yml 中 ${VAR} 替换用）
# ======================
POSTGRES_USER=lumina
POSTGRES_PASSWORD=lumina_password
POSTGRES_DB=lumina

# Redis 密码（Docker 内网不设密码，留空）
REDIS_PASSWORD=

# MinIO 对象存储（内部连接）
MINIO_ACCESS_KEY=lumina_minio
MINIO_SECRET_KEY=lumina_minio_secret
MINIO_BUCKET=lumina-images
# 完整 Docker Compose 部署时填写外部入口，例如 https://example.com；本地直运行留空，使用 localhost:9000
MINIO_PUBLIC_URL=

# ======================
# Nginx 公开入口端口（整套 Docker Compose 只暴露此端口）
# ======================
FRONTEND_PORT=3000
BACKEND_PORT=3001

# ======================
# JWT 配置
# ======================
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ======================
# CORS 配置
# ======================
CORS_ORIGIN=http://localhost:3000

# ======================
# 邮件服务配置 (SMTP)
# ======================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Lumina <noreply@example.com>"

# ======================
# 新用户初始余额（单位：光子）
# ======================
INITIAL_BALANCE=10.00

# ======================
# 本地开发连接配置（Docker 部署时由 docker-compose.yml 覆盖为内网地址）
# ======================
DATABASE_URL="postgresql://lumina:lumina_password@localhost:5432/lumina?schema=public"
REDIS_URL="redis://localhost:6379"
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false

# ======================
# 其他
# ======================
NODE_ENV=development
LOG_LEVEL=debug

# 管理员初始配置（backend 首次启动时自动创建；生产环境请务必修改）
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# ======================
# 供应商模块配置
# ======================
PROVIDER_TIMEOUT=30000
PROVIDER_MAX_RETRIES=3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT=60
PROVIDER_DEFAULT_RATE_LIMIT=60

# ======================
# 提示词优化模型兼容兜底（生图前用聊天模型扩展简短提示词）
# 首选在管理后台“模型与供应商 → 提示词优化模型”中选择已有的 CHAT 模型。
# 仅当后台尚未保存选择时，才读取这里的模型名称。
# ======================
PROMPT_OPTIMIZER_MODEL=gpt-4o-mini

# ======================
# 支付模块
# ======================
# 用于 AES-256-GCM 加密支付渠道商户配置，生产环境必须使用高强度随机值。
PAYMENT_CONFIG_ENCRYPTION_KEY=change_this_payment_encryption_key
# 公网回调地址的基础 URL，必须包含对外暴露的 API 前缀，例如 https://example.com/api；
# 支付渠道会在此地址后追加 /payments/notify/:channelId。生产环境请显式配置，
# 不要依赖 CORS_ORIGIN 的回退值。
PAYMENT_NOTIFY_BASE_URL=
# 支付完成后浏览器返回地址。
PAYMENT_RETURN_URL=http://localhost:3000/profile
