# ======================
# Docker Compose 变量（docker-compose.yml 中 ${VAR} 替换用）
# ======================
POSTGRES_USER=lumina
# Set a unique password before production deployment.
POSTGRES_PASSWORD=
POSTGRES_DB=lumina

# Redis 密码（Docker 内网不设密码，留空）
REDIS_PASSWORD=

# 本地开发用 MinIO（仅 docker-compose.dev.yml / docker-compose.e2e.yml 使用）
# 生产环境不再由后端读取这些变量；请登录管理后台配置 S3 兼容对象存储。
MINIO_ACCESS_KEY=lumina_minio
MINIO_SECRET_KEY=lumina_minio_secret
MINIO_BUCKET=lumina-images

# ======================
# Nginx 默认 HTTP 入口端口。HTTPS overlay 启用后还会映射 HTTPS_PORT。
# ======================
FRONTEND_PORT=3000
BACKEND_PORT=3001
# 可选 HTTPS overlay 使用的宿主机端口和证书目录
HTTPS_PORT=443
TLS_CERTIFICATE_DIR=./certs

# ======================
# JWT 配置
# ======================
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ======================
# CORS 配置
# ======================
CORS_ORIGIN=http://localhost:3000

# ======================
# 邮件服务配置 (SMTP)
# ======================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Lumina <noreply@example.com>"

# ======================
# 新用户初始余额（单位：光子）
# ======================
INITIAL_BALANCE=10.00

# ======================
# 本地开发连接配置（Docker 部署时由 docker-compose.yml 覆盖为内网地址）
# ======================
DATABASE_URL="postgresql://lumina:lumina_password@localhost:5432/lumina?schema=public"
REDIS_URL="redis://localhost:6379"
OBJECT_STORAGE_CONFIG_ENCRYPTION_KEY=

# ======================
# 其他
# ======================
NODE_ENV=development
LOG_LEVEL=debug

# 首次启动时，若 ADMIN_EMAIL 尚无账号会创建管理员；已存在的普通账号不会自动提权。
# 管理员密码至少 12 个字符。为已有普通账号授予管理员权限请使用 admin:promote 命令。
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ======================
# 供应商模块配置
# ======================
PROVIDER_TIMEOUT=30000
PROVIDER_MAX_RETRIES=3
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT=60
PROVIDER_DEFAULT_RATE_LIMIT=60

# ======================
# 提示词优化模型兼容兜底（生图前用聊天模型扩展简短提示词）
# 首选在管理后台“模型与供应商 → 提示词优化模型”中选择已有的 CHAT 模型。
# 仅当后台尚未保存选择时，才读取这里的模型名称。
# ======================
PROMPT_OPTIMIZER_MODEL=gpt-4o-mini

# ======================
# 支付模块
# ======================
# 用于 AES-256-GCM 加密支付渠道商户配置，生产环境必须使用高强度随机值。
PAYMENT_CONFIG_ENCRYPTION_KEY=
# 独立于支付配置的短信渠道 AES-256-GCM 加密密钥
SMS_CONFIG_ENCRYPTION_KEY=
# 公网回调地址的基础 URL，必须包含对外暴露的 API 前缀，例如 https://example.com/api；
# 支付渠道会在此地址后追加 /payments/notify/:channelId。生产环境请显式配置，
# 不要依赖 CORS_ORIGIN 的回退值。
PAYMENT_NOTIFY_BASE_URL=
# 支付完成后浏览器返回地址。
PAYMENT_RETURN_URL=http://localhost:3000/profile
# Docker production deployment routes API requests through the bundled Nginx
# proxy and enables this automatically. Set true only when the backend is
# reachable exclusively through a trusted reverse proxy.
TRUST_PROXY=false
